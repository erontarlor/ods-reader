<?xml version="1.0" encoding="UTF-8"?>
<office:document-styles
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0">

    <office:automatic-styles>

        <style:default-style style:family="automatic">
            <style:text-properties fo:font-family="Invalid Font" fo:font-size="20pt"/>
            <style:paragraph-properties fo:margin-left="2cm" fo:margin-right="2cm" fo:line-height="120%"/>
            <style:table-cell-properties style:vertical-align="middle" fo:wrap-option="wrap" style:rotation-angle="90" fo:border="0.75pt solid #000000"/>
        </style:default-style>

        <style:style style:name="ce1" style:family="automatic">
            <style:text-properties fo:font-weight="bold"/>
            <style:paragraph-properties fo:text-align="center"/>
            <style:table-cell-properties fo:background-color="#eeeeee"/>
        </style:style>

    </office:automatic-styles>

</office:document-styles>
