<?xml version="1.0" encoding="UTF-8"?>
<office:document-styles
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0">

    <office:styles>

        <style:style style:name="Cell" style:family="table-cell">
            <style:table-cell-properties fo:background-color="#eeeeee" style:vertical-align="middle" fo:wrap-option="wrap" style:rotation-angle="90" fo:border="0.75pt solid #000000" fo:border-top="1mm" fo:border-right="2mm" fo:border-bottom="3mm" fo:border-left="4mm"/>
        </style:style>

    </office:styles>

</office:document-styles>
